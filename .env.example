# URL base do servidor Evolution Go (sem barra no final)
# Exemplo: https://129.121.44.197  ou  https://meu-servidor.com
EVOLUTION_URL=https://SEU_IP_OU_DOMINIO

# Chave API global (apenas o servidor acessa — nunca exposta ao browser)
GLOBAL_API_KEY=SUA_CHAVE_AQUI

# Porta do servidor local
PORT=3000
